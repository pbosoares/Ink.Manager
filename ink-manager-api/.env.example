INK_STUDIO_ID=estudio-exemplo
POSTGRES_DB=ink_manager
POSTGRES_USER=ink_manager
POSTGRES_PASSWORD=
JWT_SECRET=
# Para producao: dominio apontado para o servidor e versao da imagem.
INK_DOMAIN=
INK_IMAGE_TAG=
PUBLIC_URL=
# Envios transacionais permanecem desligados ate validar provedor/remetente/DNS.
# Resend via SMTP: host smtp.resend.com, porta 587 com STARTTLS, usuario resend e API key como senha.
MAIL_ENABLED=false
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
# Preencher somente no ambiente privado com a API key do Resend; nunca versionar a chave.
MAIL_PASSWORD=
MAIL_FROM=agendamentos@avisos.usemarcae.com.br

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
BILLING_PROVIDER=stripe
# Preencher somente no ambiente privado Stripe (test keys primeiro); nunca versionar chaves.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_MONTHLY_AMOUNT=29.90
BILLING_TRIAL_DAYS=14
BILLING_ENFORCE=true
# Expurgo destrutivo desligado por padrao. Habilitar somente apos aprovar a politica e validar restore.
MARCAE_RETENTION_ENABLED=false
MARCAE_RETENTION_BIND_PORT=18087
MARCAE_RETENTION_OPERATOR_ID=
MARCAE_RETENTION_OPERATOR_TOKEN=
# Modo local para desenvolvimento; em produção usar backend github após provisionamento seguro.
MARCAE_CLOSURE_MANIFEST_BACKEND=file
MARCAE_CLOSURE_MANIFEST_PATH=
MARCAE_CLOSURE_MANIFEST_KEY=
MARCAE_CLOSURE_GITHUB_OWNER=
MARCAE_CLOSURE_GITHUB_REPOSITORY=
MARCAE_CLOSURE_GITHUB_BRANCH=main
MARCAE_CLOSURE_GITHUB_ANCHOR_BRANCH=manifest-anchor
MARCAE_CLOSURE_GITHUB_PATH=manifest/closures.log
MARCAE_CLOSURE_GITHUB_TOKEN=
MARCAE_CLOSURE_MANIFEST_ALLOW_INITIALIZE=false
MARCAE_WAITLIST_RETENTION_HOURS=24
MARCAE_OPERATIONAL_RETENTION_DAYS=30
# Arquivos financeiros mínimos expiram por recebimento: cinco anos após o fim do ano-calendário.
# Esse é um prazo operacional provisório, não uma regra legal universal.
